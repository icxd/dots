// shinrai · fastfetch
// Small and black and white: a sliver of the wallpaper as the logo (drawn by
// kitty's image protocol), and a short, quiet list beside it.
// Options: https://github.com/fastfetch-cli/fastfetch/wiki/Json-Schema
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "kitty",
        "source": "~/.config/fastfetch/shinrai.png",
        "width": 20,                       // columns; the height follows the picture's shape
        "padding": { "top": 2, "left": 2, "right": 4 }
    },

    "display": {
        "separator": "  ",
        "key": { "width": 8 },
        "color": {
            "keys": "bright_black",
            "title": "bright_white",
            "output": "white"
        }
    },

    "modules": [
        { "type": "title", "format": "{user-name}@{host-name}" },
        "break",
        { "type": "os", "key": "os", "format": "{pretty-name}" },
        { "type": "kernel", "key": "kernel", "format": "{release}" },
        { "type": "wm", "key": "wm" },
        { "type": "terminal", "key": "term", "format": "{pretty-name}" },
        { "type": "shell", "key": "shell", "format": "{pretty-name}" },
        { "type": "memory", "key": "memory", "format": "{used} / {total}" },
        { "type": "uptime", "key": "uptime" }
    ]
}
