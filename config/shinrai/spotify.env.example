# shinrai · Spotify keys for the launcher's music mode (Super + A).
# install.sh copies this to ~/.config/shinrai/spotify.env (readable only by you).
# It's private: keep it out of git, screenshots and pastes.
# After editing:  systemctl --user restart soloist   (search picks changes up by itself)

# 1. Spotify Soloist key (your account needs Premium):
#    https://developer.spotify.com/dashboard/soloist  ->  generate a key
SOLOIST_API_KEY=

# 2. A developer app, used for search:
#    https://developer.spotify.com/dashboard  ->  Create app
#      name and description: anything
#      Redirect URI: http://127.0.0.1:8888/callback  (required, but not used)
#      tick "Web API", save, then open Settings for the Client ID and secret
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Your account's country (two letters), so search only shows songs you can play
SPOTIFY_MARKET=SE

# The player's name in Spotify's device list
SOLOIST_DEVICE_NAME=Shinrai
